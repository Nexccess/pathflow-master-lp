{
  "functions": {
    "api/diagnose.js": {
      "maxDuration": 30
    },
    "api/reception.js": {
      "maxDuration": 30
    },
    "api/save-shigyou.js": {
      "maxDuration": 30
    },
    "api/amplitude-feed.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/p/:id(9|11)",
      "destination": "/generated/:id/index.html"
    },
    {
      "source": "/p/:id",
      "destination": "/pages/lite.html?id=:id"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
