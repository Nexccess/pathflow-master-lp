{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lead-11a-evidence.schema.json",
  "title": "11A Approved LP Evidence Payload",
  "type": "object",
  "required": [
    "lead_id",
    "store_id",
    "store_name",
    "evidence",
    "store_taste",
    "image_color_direction",
    "creative_interpretation",
    "visual_direction_summary",
    "approved_lp_html_path"
  ],
  "properties": {
    "lead_id": {"type": "integer", "minimum": 1},
    "store_id": {"type": "string", "minLength": 1},
    "store_name": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "signal", "value", "used_in"],
        "properties": {
          "type": {"enum": ["OFFICIAL", "HOTPEPPER_STORE", "HOTPEPPER_MENU", "REVIEW_TREND", "INTERPRETATION"]},
          "signal": {"type": "string", "minLength": 1},
          "value": {},
          "source_url": {"type": ["string", "null"]},
          "used_in": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "customer_voice_summary": {"type": ["array", "object", "string"]},
    "service_signals": {"type": ["array", "object", "string"]},
    "store_taste": {"type": "string", "minLength": 1},
    "image_color_direction": {"type": ["object", "array", "string"]},
    "creative_interpretation": {"type": "string", "minLength": 1},
    "visual_direction_summary": {"type": ["object", "array", "string"]},
    "approved_lp_html_path": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
